# קטלוג המקור של Higgsfield — מאות מגה של תמונות וסרטוני מקור.
# הוא נשאר על המחשב בלבד. גיט שומר כל קובץ בהיסטוריה לנצח, גם אחרי מחיקה,
# ולכן קובץ כבד שנכנס פעם אחת מנפח את הריפו לתמיד ומאט כל דפלוי ב-Vercel.
HIGGSFIELD/

# סודות. לעולם לא בריפו — משתני הסביבה מוגדרים בממשק של Vercel.
.env
.env.*

# פלט של כלים
node_modules/
.vercel/
*.log

# רעש של מערכת ההפעלה
.DS_Store
Thumbs.db
desktop.ini
